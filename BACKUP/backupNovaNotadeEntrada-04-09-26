        obs_y = obs_titulo_y - 7.0 * mm
        for i in range(5):
            hline(direita, obs_y - i * 5.3 * mm, limite_dir, .4)

        if dados.get("observacoes"):
            linhas_obs = wrap(dados.get("observacoes"), limite_dir - direita - 2 * mm, size=3.9, max_lines=4)
            for i, linha in enumerate(linhas_obs):
                txt(direita + 1.0 * mm, obs_y + 1.0 * mm - i * 5.3 * mm, linha, 3.9)

        # ==========================================================
        # RODAPÉ
        # ==========================================================
        fy = y_bottom + 6.0 * mm
        hline(9.5 * mm, fy + 3.0 * mm, x1 - 2.0 * mm, .65)
        txt(largura / 2, fy - .1 * mm, "Agradecemos a preferência!", 5.1, False, "center")
        txt(largura / 2, fy - 3.2 * mm, "VOLTE SEMPRE!", 4.2, False, "center")

    # Duas vias na mesma folha.
    primeira_via_top = altura - 3.5 * mm
    segunda_via_top = 146.0 * mm

    cabecalho_via(primeira_via_top, "CLIENTE")

    metade_corte = 149.0 * mm
    c.setStrokeColorRGB(*CINZA)
    c.setDash(4, 3)
    c.setLineWidth(.4)
    c.line(8 * mm, metade_corte, largura - 8 * mm, metade_corte)
    c.setDash()

    cabecalho_via(segunda_via_top, "LOJA")

    c.save()

    try:
        if os.name == "nt":
            os.startfile(caminho_pdf)
        else:
            import subprocess
            subprocess.Popen(["xdg-open", caminho_pdf])
    except Exception:
        pass

    return caminho_pdf

def calcular_status_automatico(dados, status_padrao="em_orcamento"):
    """Define o status pelas marcações da tela. Serviço autorizado tem prioridade."""
    autorizado = bool(dados.get("autorizado"))
    orcamento = bool(dados.get("orcamento"))

    if autorizado:
        return "aguardando_peca"
    if orcamento:
        return "em_orcamento"
    return status_padrao


def salvar_nota(dados):
    conn = get_conn()
    cur = conn.cursor()
    cur.execute(
        "INSERT INTO clientes (nome, telefone, endereco, apelido) VALUES (?, ?, ?, ?)",
        (dados["nome"], dados["telefone"], dados["endereco"], dados["apelido"]),
    )
    cliente_id = cur.lastrowid
    cur.execute(
                 """INSERT INTO aparelhos
            (cliente_id, marca, modelo, senha, acessorios, defeitos, servico, autorizado, valor,
             orcamento, relatorio, observacoes, status, data_entrada)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
        (
            cliente_id,
            dados["marca"], dados["modelo"], dados["senha"], dados["acessorios"],
                         dados["defeitos"], dados["servico"], 1 if dados["autorizado"] else 0, dados["valor"],
            1 if dados["orcamento"] else 0, dados["relatorio"], dados["observacoes"],
            calcular_status_automatico(dados),
            datetime.now().strftime("%d/%m/%Y %H:%M"),
        ),
    )
    # GARANTIA: depois de inserir, força novamente o status no próprio banco.
    # Isso evita que qualquer valor padrão/status anterior substitua a regra dos checkboxes.
    aparelho_id = cur.lastrowid
    if dados.get("autorizado"):
        status_final = "aguardando_peca"
    elif dados.get("orcamento"):
        status_final = "em_orcamento"
    else:
        status_final = dados.get("status", "em_orcamento")

    cur.execute(
        "UPDATE aparelhos SET status = ? WHERE id = ?",
        (status_final, aparelho_id),
    )

    conn.commit()
    conn.close()


