                    width=78,
                    height=78,
                    fit=ft.BoxFit.CONTAIN,
                )
                if caminho and os.path.isfile(caminho)
                else ft.Icon(
                    ft.Icons.IMAGE_OUTLINED,
                    size=40,
                    color="#9AA0AC",
                )
            )

            logo_info.value = (
