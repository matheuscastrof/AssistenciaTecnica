            page.update()

        atualizar_preview(logo_path_atual[0])

        # ----------------------------------------------------------
        # SELECIONAR LOGO
        # ----------------------------------------------------------
      
        async def selecionar_logo(e):
            try:
                arquivos = await file_picker.pick_files(
                    dialog_title="Selecione a logo da loja",
                    allow_multiple=False,
                    file_type=ft.FilePickerFileType.IMAGE,
                )

                if not arquivos:
                    return

                arquivo = arquivos[0]
                caminho_origem = arquivo.path

                if not caminho_origem or not os.path.isfile(caminho_origem):
                    raise FileNotFoundError(
                        "Não foi possível acessar a imagem selecionada."
                    )

                pasta_config = os.path.join(
                    BASE_DIR,
                    "configuracoes"
                )

                os.makedirs(
                    pasta_config,
                    exist_ok=True
                )

                extensao = (
                    os.path.splitext(caminho_origem)[1].lower()
                    or ".png"
                )

                # ======================================================
                # IMPORTANTE:
                # Cada nova logo recebe um nome diferente.
                #
                # Isso evita que o Flet reutilize a imagem anterior
                # que estava em cache.
                # ======================================================
                nome_unico = f"logo_loja_{time.time_ns()}{extensao}"

                caminho_destino = os.path.join(
                    pasta_config,
                    nome_unico
                )

                # Copia a nova logo para um arquivo novo.
                shutil.copy2(
                    caminho_origem,
                    caminho_destino
                )

                # ======================================================
                # Remove a logo anterior SOMENTE depois que a nova
                # já foi copiada com sucesso.
                # ======================================================
                caminho_anterior = logo_path_atual[0]

                if (
                    caminho_anterior
                    and caminho_anterior != caminho_destino
                    and os.path.isfile(caminho_anterior)
                ):
                    try:
                        os.remove(caminho_anterior)
                    except OSError:
                        pass

                # Atualiza o caminho atualmente selecionado.
                logo_path_atual[0] = caminho_destino

                # Atualiza imediatamente a prévia da configuração.
                atualizar_preview(caminho_destino)

                # ======================================================
                # IMPORTANTE:
                # Atualiza também a logo do menu lateral imediatamente,
                # sem precisar fechar e abrir o sistema.
                # ======================================================
                logo_menu.bgcolor = "#F2F3F7"
                logo_menu.content = ft.Image(
                    src=caminho_destino,
                    width=38,
                    height=38,
                    fit=ft.BoxFit.CONTAIN,
                )

                page.update()

            except Exception as erro:
                page.overlay.append(
                    ft.SnackBar(
                        ft.Text(
                            f"Erro ao salvar a logo: {erro}"
                        ),
                        bgcolor="#E5484D",
                        open=True,
                    )
                )

                page.update()



        # ----------------------------------------------------------
