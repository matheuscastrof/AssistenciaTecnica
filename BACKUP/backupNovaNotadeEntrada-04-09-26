    caminho_pdf = os.path.join(pasta_impressoes, nome_arquivo)

    largura, altura = A4
    c = canvas.Canvas(caminho_pdf, pagesize=A4)

    PRETO = (0.03, 0.03, 0.03)
    CINZA = (0.48, 0.48, 0.48)
    VERDE_WHATS = (0.12, 0.72, 0.31)
    ROSA_INSTA = (0.82, 0.20, 0.48)

    # Dados da loja vêm das Configurações do sistema.
    config = obter_configuracoes()
    NOME_ASSISTENCIA = config.get("nome_loja") or "MINHA ASSISTÊNCIA"
    SUBTITULO = "ASSISTÊNCIA TÉCNICA ESPECIALIZADA"
    WHATSAPP = config.get("whatsapp") or ""
    INSTAGRAM = config.get("instagram") or ""
    ENDERECO_LOJA = config.get("endereco") or ""
    TELEFONE_LOJA = config.get("telefone") or ""
    LOGO_LOJA = config.get("logo_path") or ""

    def txt(x, y, valor, tamanho=6, bold=False, align="left", cor=PRETO):
        c.setFillColorRGB(*cor)
        c.setFont("Helvetica-Bold" if bold else "Helvetica", tamanho)
        valor = str(valor or "-")
        if align == "center":
            c.drawCentredString(x, y, valor)
        elif align == "right":
            c.drawRightString(x, y, valor)
        else:
            c.drawString(x, y, valor)

    def hline(x1, y, x2, w=.45, cor=CINZA):
        c.setStrokeColorRGB(*cor)
        c.setLineWidth(w)
        c.line(x1, y, x2, y)
        c.setStrokeColorRGB(*PRETO)

    def vline(x, y1, y2, w=.45, cor=CINZA):
        c.setStrokeColorRGB(*cor)
        c.setLineWidth(w)
        c.line(x, y1, x, y2)
        c.setStrokeColorRGB(*PRETO)

    def wrap(texto, max_width, font="Helvetica", size=4.3, max_lines=2):
        texto = str(texto or "-").strip()
        palavras = texto.split()
        linhas = []
        atual = ""
        for palavra in palavras:
            teste = f"{atual} {palavra}".strip()
            if c.stringWidth(teste, font, size) <= max_width:
                atual = teste
            else:
                if atual:
                    linhas.append(atual)
                atual = palavra
        if atual:
            linhas.append(atual)
        return linhas[:max_lines] or ["-"]

    def icon(x, y, kind, size=6.0 * mm):
        """Ícones pretos usados nos campos, semelhantes aos do modelo."""
        c.setFillColorRGB(*PRETO)
        c.roundRect(x, y, size, size, 1.0 * mm, fill=1, stroke=0)
        cx = x + size / 2
        cy = y + size / 2
        c.setStrokeColorRGB(1, 1, 1)
        c.setFillColorRGB(1, 1, 1)
        c.setLineWidth(.65)

        if kind == "person":
            c.circle(cx, cy + 1.0 * mm, .9 * mm, fill=1, stroke=0)
            c.roundRect(cx - 1.8 * mm, cy - 2.0 * mm, 3.6 * mm, 2.0 * mm, .6 * mm, fill=1, stroke=0)
        elif kind == "phone":
            c.roundRect(cx - 1.25 * mm, cy - 2.35 * mm, 2.5 * mm, 4.7 * mm, .45 * mm, fill=0, stroke=1)
            c.circle(cx, cy - 1.75 * mm, .16 * mm, fill=1, stroke=0)
        elif kind == "alert":
            p = c.beginPath()
            p.moveTo(cx, y + 5.0 * mm)
            p.lineTo(x + 5.0 * mm, y + 1.0 * mm)
            p.lineTo(x + 1.0 * mm, y + 1.0 * mm)
            p.close()
            c.drawPath(p, fill=1, stroke=0)
            c.setFillColorRGB(*PRETO)
            c.setFont("Helvetica-Bold", 3.6 * mm)
            c.drawCentredString(cx, y + 1.35 * mm, "!")
        elif kind == "wrench":
            c.setLineWidth(1.0)
            c.line(x + 1.5 * mm, y + 1.5 * mm, x + 4.8 * mm, y + 4.8 * mm)
            c.circle(x + 1.5 * mm, y + 1.5 * mm, .65 * mm, fill=0, stroke=1)
            c.circle(x + 4.8 * mm, y + 4.8 * mm, .75 * mm, fill=0, stroke=1)
        elif kind == "money":
            c.setFillColorRGB(1, 1, 1)
            c.setFont("Helvetica-Bold", 3.6 * mm)
            c.drawCentredString(cx, y + .9 * mm, "R$")
        elif kind == "pencil":
            c.setLineWidth(1.1)
            c.line(x + 1.4 * mm, y + 1.4 * mm, x + 4.8 * mm, y + 4.8 * mm)
        c.setFillColorRGB(*PRETO)
        c.setStrokeColorRGB(*PRETO)

    def checkbox(x, y, marcado=False):
        tamanho = 5.0 * mm
        c.setStrokeColorRGB(*PRETO)
        c.setLineWidth(.75)
        c.rect(x, y, tamanho, tamanho, fill=0, stroke=1)
        if marcado:
            c.setLineWidth(1.0)
            c.line(x + 1.0 * mm, y + 2.5 * mm, x + 2.1 * mm, y + 1.2 * mm)
            c.line(x + 2.1 * mm, y + 1.2 * mm, x + 4.2 * mm, y + 4.0 * mm)


    def whatsapp_icon(cx, cy, r=2.1 * mm):
        imagem_whatsapp = ImageReader("icons8-whatsapp-48.png")

        tamanho = r * 2

        c.drawImage(
            imagem_whatsapp,
            cx - tamanho / 2,
            cy - tamanho / 2,
            width=tamanho,
            height=tamanho,
            mask="auto"
        )

    def instagram_icon(cx, cy, size=4.0 * mm):
        x = cx - size / 2
        y = cy - size / 2
        c.setStrokeColorRGB(*ROSA_INSTA)
        c.setLineWidth(.9)
        c.roundRect(x, y, size, size, .9 * mm, fill=0, stroke=1)
        c.circle(cx, cy, .9 * mm, fill=0, stroke=1)
        c.setFillColorRGB(*ROSA_INSTA)
        c.circle(x + 3.0 * mm, y + 3.0 * mm, .28 * mm, fill=1, stroke=0)
        c.setStrokeColorRGB(*PRETO)

    def pattern(cx, cy):
        """Grade 3x3 de pontos exatamente na área direita superior."""
        dx = 10.0 * mm
        dy = 8.0 * mm
        c.setStrokeColorRGB(*PRETO)
        c.setLineWidth(.55)
        for row in range(3):
            for col in range(3):
                c.circle(cx + (col - 1) * dx, cy + (1 - row) * dy, 1.25 * mm, fill=0, stroke=1)

