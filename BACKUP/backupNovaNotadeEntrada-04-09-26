def get_conn():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    return conn


def init_db():
    conn = get_conn()
    conn.executescript(
        """
        CREATE TABLE IF NOT EXISTS clientes (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nome TEXT NOT NULL,
            telefone TEXT,
            endereco TEXT,
            apelido TEXT
        );
        CREATE TABLE IF NOT EXISTS aparelhos (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            cliente_id INTEGER,
            marca TEXT,
            modelo TEXT,
            senha TEXT,
            acessorios TEXT,
            defeitos TEXT,
            servico TEXT,
            autorizado INTEGER DEFAULT 0,
            valor TEXT,
            orcamento INTEGER DEFAULT 0,
            relatorio TEXT,
            observacoes TEXT,
            status TEXT DEFAULT 'em_manutencao',
            data_entrada TEXT,
            FOREIGN KEY(cliente_id) REFERENCES clientes(id)
        );
        CREATE TABLE IF NOT EXISTS pecas (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nome TEXT NOT NULL,
            quantidade INTEGER DEFAULT 0,
            preco REAL DEFAULT 0
        );

        CREATE TABLE IF NOT EXISTS configuracoes (
            id INTEGER PRIMARY KEY CHECK (id = 1),
            nome_loja TEXT DEFAULT 'MINHA ASSISTÊNCIA',
            endereco TEXT DEFAULT '',
            telefone TEXT DEFAULT '',
            whatsapp TEXT DEFAULT '',
            instagram TEXT DEFAULT '',
            logo_path TEXT DEFAULT ''
        );
        """
    )

    # --- Migração automática: adiciona qualquer coluna que esteja faltando ---
    colunas_esperadas = {
        "cliente_id": "INTEGER",
        "marca": "TEXT",
        "modelo": "TEXT",
        "senha": "TEXT",
        "acessorios": "TEXT",
        "defeitos": "TEXT",
        "servico": "TEXT",
        "autorizado": "INTEGER DEFAULT 0",
        "valor": "TEXT",
        "orcamento": "INTEGER DEFAULT 0",
        "relatorio": "TEXT",
        "observacoes": "TEXT",
        "status": "TEXT DEFAULT 'em_manutencao'",
        "data_entrada": "TEXT",
    }
    colunas_atuais = {row["name"] for row in conn.execute("PRAGMA table_info(aparelhos)")}
    for nome_col, tipo_col in colunas_esperadas.items():
        if nome_col not in colunas_atuais:
            conn.execute(f"ALTER TABLE aparelhos ADD COLUMN {nome_col} {tipo_col}")

    # Garante que exista uma única configuração da loja.
    conn.execute(
        """INSERT OR IGNORE INTO configuracoes
           (id, nome_loja, endereco, telefone, whatsapp, instagram, logo_path)
           VALUES (1, 'MINHA ASSISTÊNCIA', '', '', '', '', '')"""
    )

    conn.commit()
    conn.close()


def obter_configuracoes():
    conn = get_conn()
    row = conn.execute(
        "SELECT * FROM configuracoes WHERE id = 1"
    ).fetchone()
    conn.close()

    if row:
        return dict(row)

    return {
        "id": 1,
        "nome_loja": "MINHA ASSISTÊNCIA",
        "endereco": "",
        "telefone": "",
        "whatsapp": "",
        "instagram": "",
        "logo_path": "",
    }


def salvar_configuracoes(nome_loja, endereco, telefone, whatsapp, instagram, logo_path=""):
    """Salva/atualiza a única configuração da loja no SQLite."""
    conn = get_conn()
    try:
        conn.execute(
            """INSERT INTO configuracoes
               (id, nome_loja, endereco, telefone, whatsapp, instagram, logo_path)
               VALUES (1, ?, ?, ?, ?, ?, ?)
               ON CONFLICT(id) DO UPDATE SET
                   nome_loja = excluded.nome_loja,
                   endereco = excluded.endereco,
                   telefone = excluded.telefone,
                   whatsapp = excluded.whatsapp,
                   instagram = excluded.instagram,
                   logo_path = excluded.logo_path""",
            (
                str(nome_loja or "").strip(),
                str(endereco or "").strip(),
                str(telefone or "").strip(),
                str(whatsapp or "").strip(),
                str(instagram or "").strip(),
                str(logo_path or "").strip(),
            ),
        )
        conn.commit()
    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()


def proximo_numero_os():
    """Retorna o próximo número de OS sem reutilizar números já gerados."""
    conn = get_conn()
    row = conn.execute(
        "SELECT COALESCE(MAX(id), 0) AS maior_id FROM aparelhos"
    ).fetchone()
    maior_id = int(row["maior_id"] or 0)

    # O AUTOINCREMENT do SQLite mantém o maior ID já utilizado,
    # inclusive quando uma OS antiga é excluída.
    seq_row = conn.execute(
        "SELECT seq FROM sqlite_sequence WHERE name = 'aparelhos'"
    ).fetchone()
    sequencia = int(seq_row["seq"] or 0) if seq_row else 0

    conn.close()
    return max(maior_id, sequencia) + 1


def formatar_os(numero):
    """Formata a OS com quatro dígitos: 1 -> 0001."""
    return f"OS {int(numero):04d}"


def imprimir_nota_entrada(dados, numero_os):
    """Gera a OS em A4 com duas vias, seguindo o modelo do PDF de referência."""
