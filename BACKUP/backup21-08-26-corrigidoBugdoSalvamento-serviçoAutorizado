    def pagina_aparelhos():
        aparelhos = listar_aparelhos()

        status_info = {
            "pronto": (
                "#17B96B",
                "Aparelhos Prontos",
                "Visualizar aparelhos\nprontos para entrega",
                ft.Icons.PHONE_ANDROID_ROUNDED,
            ),
            "sem_solucao": (
                "#E51D25",
                "Sem Solução",
                "Aparelhos sem solução\nno momento",
                ft.Icons.BUILD_ROUNDED,
            ),
            "aguardando_peca": (
                "#F39A16",
                "Aguardando Peça",
                "Aguardando chegada\nde peça",
                ft.Icons.INVENTORY_2_ROUNDED,
            ),
            "aguardando_autorizacao": (
                "#6738E8",
                "Aguardando Autorização",
                "Aguardando autorização\ndo cliente",
                ft.Icons.SHIELD_ROUNDED,
            ),
            "em_orcamento": (
                "#2583E8",
                "Em Orçamento",
                "Aguardando aprovação\ndo orçamento",
                ft.Icons.REQUEST_QUOTE_ROUNDED,
            ),
            "entregue": (
                "#7A5AF8",
                "Aparelhos Entregues",
                "Aparelhos que já foram\nentregues ao cliente",
                ft.Icons.LOCAL_SHIPPING_ROUNDED,
            ),
        }

        status_alias = {
            "concluido": "pronto",
            "em_manutencao": "em_orcamento",
        }

        def status_real(a):
            return status_alias.get(a["status"], a["status"] or "em_orcamento")

        def atualizar_status(aparelho_id, novo_status):
            conn = get_conn()
            conn.execute(
                "UPDATE aparelhos SET status = ? WHERE id = ?",
                (novo_status, aparelho_id),
            )
            conn.commit()
            conn.close()

        def fechar_dialog(dialogo):
            dialogo.open = False
            page.update()

        def abrir_form_aparelho(aparelho=None):
            editando = aparelho is not None
            clientes_atual = listar_clientes()

            if not clientes_atual:
                page.overlay.append(
                    ft.SnackBar(
                        ft.Text("Cadastre um cliente antes de adicionar um aparelho."),
                        bgcolor="#E5484D",
                        open=True,
                    )
                )
                page.update()
                return

            cliente_options = [
                ft.dropdown.Option(str(c["id"]), c["nome"])
                for c in clientes_atual
            ]

            cliente_f = ft.Dropdown(
                label="Cliente",
                options=cliente_options,
                expand=True,
            )
            marca_f = campo("Marca do dispositivo")
            modelo_f = campo("Modelo do dispositivo")
            senha_f = campo("Senha", password=True)
            acessorios_f = campo("Acessórios")
            defeitos_f = campo("Defeito relatado")
            servico_f = campo("Serviço realizado")
            autorizado_f = ft.Checkbox(label="Serviço Autorizado", value=False)
            valor_f = campo("Valor do serviço (R$)")
            orcamento_f = ft.Checkbox(label="Orçamento", value=False)

            status_options = [
                ft.dropdown.Option("pronto", "Aparelho Pronto"),
                ft.dropdown.Option("sem_solucao", "Sem Solução"),
                ft.dropdown.Option("aguardando_peca", "Aguardando Peça"),
                ft.dropdown.Option(
                    "aguardando_autorizacao", "Aguardando Autorização"
                ),
                ft.dropdown.Option("em_orcamento", "Em Orçamento"),
                ft.dropdown.Option("entregue", "Aparelho Entregue"),
            ]

            status_f = ft.Dropdown(
                label="Status do aparelho",
                options=status_options,
                expand=True,
            )

            relatorio_f = campo(
                "Relatório Técnico", multiline=True, min_lines=3, max_lines=5
            )
            observacoes_f = campo(
                "Observações", multiline=True, min_lines=3, max_lines=5
            )

            if aparelho:
                cliente_f.value = (
                    str(aparelho["cliente_id"])
                    if aparelho["cliente_id"]
                    else None
                )
                marca_f.value = aparelho["marca"] or ""
                modelo_f.value = aparelho["modelo"] or ""
                senha_f.value = aparelho["senha"] or ""
                acessorios_f.value = aparelho["acessorios"] or ""
                defeitos_f.value = aparelho["defeitos"] or ""
                servico_f.value = aparelho["servico"] or ""
                autorizado_f.value = bool(aparelho["autorizado"])
                valor_f.value = aparelho["valor"] or ""
                orcamento_f.value = bool(aparelho["orcamento"])
                status_f.value = status_real(aparelho)
                relatorio_f.value = aparelho["relatorio"] or ""
                observacoes_f.value = aparelho["observacoes"] or ""
            else:
                status_f.value = "em_orcamento"

            def salvar_form(e):
                if not cliente_f.value:
                    page.overlay.append(
                        ft.SnackBar(
                            ft.Text("Selecione um cliente."),
                            bgcolor="#E5484D",
                            open=True,
                        )
                    )
                    page.update()
                    return

                dados = {
                    "cliente_id": int(cliente_f.value),
                    "marca": marca_f.value or "",
                    "modelo": modelo_f.value or "",
                    "senha": senha_f.value or "",
                    "acessorios": acessorios_f.value or "",
                    "defeitos": defeitos_f.value or "",
                    "servico": servico_f.value or "",
                    "autorizado": autorizado_f.value,
                    "valor": valor_f.value or "",
                    "orcamento": orcamento_f.value,
                    "relatorio": relatorio_f.value or "",
                    "observacoes": observacoes_f.value or "",
                }

                # Regras automáticas de status:
                # Orçamento marcado -> Em Orçamento
                # Serviço autorizado marcado -> Aguardando Peça
                # Se nenhum dos dois estiver marcado, mantém o status escolhido.
                if autorizado_f.value:
                    status_automatico = "aguardando_peca"
                elif orcamento_f.value:
                    status_automatico = "em_orcamento"
                else:
                    status_automatico = status_f.value or "em_orcamento"

                if editando:
                    atualizar_aparelho(aparelho["id"], dados)
                    atualizar_status(aparelho["id"], status_automatico)
                else:
                    dados["status"] = status_automatico
                    adicionar_aparelho(dados)

                fechar_dialog(dialogo)
                navegar("aparelhos")

            dialogo = ft.AlertDialog(
                modal=True,
                title=ft.Text(
                    "Editar aparelho" if editando else "Adicionar aparelho"
                ),
                content=ft.Column(
                    [
                        cliente_f,
                        ft.Row([marca_f, modelo_f], spacing=10),
                        ft.Row([senha_f, acessorios_f], spacing=10),
                        defeitos_f,
                        ft.Row(
                            [autorizado_f, orcamento_f],
                            spacing=15,
                        ),
                        status_f,
                        valor_f,
                        ft.Row(
                            [relatorio_f, observacoes_f],
                            spacing=10,
                        ),
                    ],
                    tight=True,
                    width=650,
                    scroll=ft.ScrollMode.AUTO,
                ),
                actions=[
                    ft.TextButton(
                        "Cancelar",
                        on_click=lambda e: fechar_dialog(dialogo),
                    ),
                    ft.ElevatedButton(
                        "Salvar",
                        bgcolor="#3B5BFD",
                        color="white",
                        on_click=salvar_form,
                    ),
                ],
                actions_alignment=ft.MainAxisAlignment.END,
            )

            page.overlay.append(dialogo)
            dialogo.open = True
            page.update()

        def confirmar_exclusao(aparelho):
            def excluir(e):
                excluir_aparelho(aparelho["id"])
                fechar_dialog(dialogo)
                navegar("aparelhos")

            dialogo = ft.AlertDialog(
                modal=True,
                title=ft.Text("Excluir aparelho"),
                content=ft.Text(
                    "Deseja realmente excluir este aparelho?"
                ),
                actions=[
                    ft.TextButton(
                        "Cancelar",
                        on_click=lambda e: fechar_dialog(dialogo),
                    ),
                    ft.ElevatedButton(
                        "Excluir",
                        bgcolor="#E5484D",
                        color="white",
                        on_click=excluir,
                    ),
                ],
            )

            page.overlay.append(dialogo)
            dialogo.open = True
            page.update()

        def corresponde(a, termo):
            if not termo:
                return True

            partes = [
                a["cliente_nome"],
                a["cliente_telefone"],
                a["marca"],
                a["modelo"],
                a["senha"],
                a["acessorios"],
                a["defeitos"],
                a["servico"],
                a["valor"],
                a["relatorio"],
                a["observacoes"],
                a["data_entrada"],
                status_info.get(
                    status_real(a),
                    ("", status_real(a), "", None),
                )[1],
            ]

            texto = " ".join(
                str(x or "") for x in partes
            ).lower()

            return termo.lower().strip() in texto

        def montar_linha_aparelho(a, status_atual):
            cor, titulo, _, _ = status_info[status_atual]

            acoes = [
                ft.TextButton(
                    "Editar",
                    icon=ft.Icons.EDIT_OUTLINED,
                    on_click=lambda e, x=a: abrir_form_aparelho(x),
                ),
                ft.TextButton(
                    "Excluir",
                    icon=ft.Icons.DELETE_OUTLINE_ROUNDED,
                    on_click=lambda e, x=a: confirmar_exclusao(x),
                ),
            ]

            if status_atual == "pronto":
                acoes.insert(
                    0,
                    ft.ElevatedButton(
                        "Marcar como Entregue",
                        icon=ft.Icons.LOCAL_SHIPPING_ROUNDED,
                        bgcolor="#7A5AF8",
                        color="white",
                        on_click=lambda e, x=a: (
                            atualizar_status(x["id"], "entregue"),
                            navegar("aparelhos"),
                        ),
                    ),
                )

            outros_status = [
                (st, info[1])
                for st, info in status_info.items()
                if st != status_atual
            ]

            acoes.append(
                ft.PopupMenuButton(
                    icon=ft.Icons.MORE_VERT,
                    tooltip="Alterar status",
                    items=[
                        ft.PopupMenuItem(
                            content=ft.Text(rotulo),
                            on_click=lambda e, x=a, st=st: (
                                atualizar_status(x["id"], st),
                                navegar("aparelhos"),
                            ),
                        )
                        for st, rotulo in outros_status
                    ],
                )
            )

            return ft.Container(
                content=ft.Column(
                    [
                        ft.Row(
                            [
                                ft.Column(
                                    [
                                        ft.Text(
                                            f"{a['marca'] or '-'} {a['modelo'] or ''}".strip(),
                                            size=17,
                                            weight=ft.FontWeight.BOLD,
                                            color="#1F2430",
                                        ),
                                        ft.Text(
                                            f"Cliente: {a['cliente_nome'] or '-'}",
                                            size=12,
                                            color="#6B7280",
                                        ),
                                        ft.Text(
                                            f"Telefone: {a['cliente_telefone'] or '-'}",
                                            size=12,
                                            color="#6B7280",
                                        ),
                                        ft.Text(
                                            f"Defeito: {a['defeitos'] or '-'}",
                                            size=13,
                                            color="#3D4250",
                                        ),
                                        ft.Text(
                                            f"Serviço: {a['servico'] or '-'}",
                                            size=13,
                                            color="#3D4250",
                                        ),
                                        ft.Text(
                                            f"Valor: R$ {a['valor'] or '0,00'}",
                                            size=13,
                                            color="#2E8BF0",
                                            weight=ft.FontWeight.BOLD,
                                        ),
                                        ft.Text(
                                            f"Entrada: {a['data_entrada'] or '-'}",
                                            size=11,
                                            color="#9AA0AC",
                                        ),
                                    ],
                                    spacing=3,
                                    expand=True,
                                ),
                                ft.Container(
                                    content=ft.Text(
                                        titulo,
                                        size=12,
                                        color="white",
                                        weight=ft.FontWeight.BOLD,
                                    ),
                                    bgcolor=cor,
                                    border_radius=20,
                                    padding=ft.Padding.symmetric(
                                        vertical=6,
                                        horizontal=12,
                                    ),
                                ),
                            ],
                            vertical_alignment=ft.CrossAxisAlignment.START,
                        ),
                        ft.Row(
                            acoes,
                            alignment=ft.MainAxisAlignment.END,
                            wrap=True,
                        ),
                    ],
                    spacing=8,
                ),
                bgcolor="white",
                border_radius=10,
                padding=16,
                shadow=sombra_cartao,
            )

        # --------------------------------------------------------------
        # Busca geral
        # --------------------------------------------------------------
        termo_global = ""

        def realizar_busca_global(e):
            nonlocal termo_global
            termo_global = e.control.value or ""
            atualizar_conteudo()

        busca_global = ft.TextField(
            hint_text="Pesquisar...",
            label=None,
            prefix_icon=ft.Icons.SEARCH_ROUNDED,
            expand=True,
            text_size=18,
            height=64,
            content_padding=ft.Padding.symmetric(
                horizontal=18,
                vertical=8,
            ),
            border_radius=12,
            bgcolor="white",
            border_color="#E5E7EB",
            on_change=realizar_busca_global,
        )

        resultado_global = ft.Column(
            spacing=12,
            scroll=ft.ScrollMode.AUTO,
        )

        def mostrar_resultados_globais():
            resultado_global.controls.clear()

            termo = termo_global.strip()
            if not termo:
                return

            encontrados = [
                a for a in aparelhos
                if corresponde(a, termo)
            ]

            resultado_global.controls.append(
                ft.Text(
                    f"Resultados para: {termo}",
                    size=18,
                    weight=ft.FontWeight.BOLD,
                    color="#1F2430",
                )
            )

            if not encontrados:
                resultado_global.controls.append(
                    ft.Container(
                        content=ft.Text(
                            "Nenhum aparelho encontrado.",
                            color="#9AA0AC",
                            size=14,
                        ),
                        padding=20,
                    )
                )
                return

            for a in encontrados:
                resultado_global.controls.append(
                    montar_linha_aparelho(
                        a,
                        status_real(a),
                    )
                )

        # --------------------------------------------------------------
        # Cards da tela inicial
        # --------------------------------------------------------------
        cards_area = ft.Column(spacing=20)

        def abrir_categoria(status):
            renderizar_categoria(status)

        def criar_card_status(status):
            cor, titulo, descricao, icone = status_info[status]

            quantidade = sum(
                1
                for a in aparelhos
                if status_real(a) == status
            )

            # Ícone dentro de um círculo, como no modelo enviado.
            circulo = ft.Container(
                content=ft.Icon(
                    icone,
                    color=cor,
                    size=50,
                ),
                width=100,
                height=100,
                border_radius=50,
                bgcolor=f"{cor}18",
                alignment=ft.Alignment.CENTER,
            )

            return ft.Container(
                width=290,
                height=275,
                bgcolor="white",
                border_radius=14,
                padding=ft.Padding.only(
                    left=24,
                    right=24,
                    top=30,
                    bottom=24,
                ),
                shadow=sombra_cartao,
                ink=True,
                on_click=lambda e, st=status: abrir_categoria(st),
                content=ft.Column(
                    [
                        circulo,
                        ft.Container(height=8),
                        ft.Text(
                            titulo,
                            size=19,
                            weight=ft.FontWeight.BOLD,
                            color="#172033",
                            text_align=ft.TextAlign.CENTER,
                        ),
                        ft.Text(
                            descricao,
                            size=16,
                            color="#65708A",
                            text_align=ft.TextAlign.CENTER,
                        ),
                        ft.Text(
                            f"{quantidade} aparelho(s)",
                            size=13,
                            color=cor,
                            weight=ft.FontWeight.BOLD,
                        ),
                    ],
                    horizontal_alignment=ft.CrossAxisAlignment.CENTER,
                    alignment=ft.MainAxisAlignment.CENTER,
                    spacing=8,
                ),
            )

        def montar_cards():
            cards_area.controls.clear()

            # Exatamente como no modelo: 3 cards na primeira linha e
            # 2 cards na segunda, mantendo a largura dos cards.
            primeira_linha = ft.Row(
                [
                    criar_card_status("pronto"),
                    criar_card_status("sem_solucao"),
                    criar_card_status("aguardando_peca"),
                ],
                spacing=20,
                alignment=ft.MainAxisAlignment.START,
            )

            segunda_linha = ft.Row(
                [
                    criar_card_status("aguardando_autorizacao"),
                    criar_card_status("em_orcamento"),
                    criar_card_status("entregue"),
                ],
                spacing=20,
                alignment=ft.MainAxisAlignment.START,
                wrap=True,
            )

            cards_area.controls.extend(
                [
                    primeira_linha,
                    segunda_linha,
                ]
            )

        # --------------------------------------------------------------
        # Tela interna de uma categoria
        # --------------------------------------------------------------
        categoria_atual = None

        def renderizar_categoria(status):
            nonlocal categoria_atual
            categoria_atual = status

            cor, titulo, descricao, icone = status_info[status]

            busca_categoria = ft.TextField(
                hint_text=f"Pesquisar em {titulo.lower()}...",
                prefix_icon=ft.Icons.SEARCH_ROUNDED,
                expand=True,
                text_size=15,
            )

            lista_categoria = ft.Column(
                spacing=12,
                scroll=ft.ScrollMode.AUTO,
                expand=True,
            )

            def atualizar_lista_categoria(e=None):
                termo = busca_categoria.value or ""

                lista_categoria.controls.clear()

                itens = [
                    a for a in aparelhos
                    if status_real(a) == status
                    and corresponde(a, termo)
                ]

                if not itens:
                    lista_categoria.controls.append(
                        ft.Container(
                            content=ft.Column(
                                [
                                    ft.Icon(
                                        icone,
                                        size=50,
                                        color="#B0B6C4",
                                    ),
                                    ft.Text(
                                        "Nenhum aparelho encontrado.",
                                        size=16,
                                        color="#8A91A1",
                                    ),
                                ],
                                horizontal_alignment=ft.CrossAxisAlignment.CENTER,
                                spacing=8,
                            ),
                            padding=40,
                            alignment=ft.Alignment.CENTER,
                        )
                    )
                else:
                    lista_categoria.controls.extend(
                        [
                            montar_linha_aparelho(a, status)
                            for a in itens
                        ]
                    )

                page.update()

            busca_categoria.on_change = atualizar_lista_categoria

            atualizar_lista_categoria()

            conteudo_categoria = ft.Column(
                [
                    ft.Row(
                        [
                            ft.IconButton(
                                icon=ft.Icons.ARROW_BACK_ROUNDED,
                                tooltip="Voltar",
                                on_click=lambda e: mostrar_inicio(),
                            ),
                            ft.Container(
                                content=ft.Icon(
                                    icone,
                                    color=cor,
                                    size=28,
                                ),
                                width=52,
                                height=52,
                                border_radius=26,
                                bgcolor=f"{cor}18",
                                alignment=ft.Alignment.CENTER,
                            ),
                            ft.Column(
                                [
                                    ft.Text(
                                        titulo,
                                        size=25,
                                        weight=ft.FontWeight.BOLD,
                                        color="#1F2430",
                                    ),
                                    ft.Text(
                                        descricao.replace("\n", " "),
                                        size=13,
                                        color="#6B7280",
                                    ),
                                ],
                                spacing=2,
                                expand=True,
                            ),
                        ],
                        vertical_alignment=ft.CrossAxisAlignment.CENTER,
                    ),
                    busca_categoria,
                    ft.Container(
                        content=lista_categoria,
                        expand=True,
                    ),
                ],
                spacing=14,
                expand=True,
            )

            area_principal.controls.clear()
            area_principal.controls.append(conteudo_categoria)
            page.update()

        def mostrar_inicio():
            nonlocal categoria_atual
            categoria_atual = None
            montar_cards()

            area_principal.controls.clear()
            area_principal.controls.append(cards_area)

            atualizar_conteudo()

        def atualizar_conteudo():
            if categoria_atual is not None:
                return

            montar_cards()
            mostrar_resultados_globais()

            area_principal.controls.clear()

            if termo_global.strip():
                area_principal.controls.append(resultado_global)
            else:
                area_principal.controls.append(cards_area)

            page.update()

        area_principal = ft.Column(
            spacing=16,
            expand=True,
        )

        # A primeira abertura da página deve mostrar os cards.
        # Antes, os cards eram montados em `cards_area`, mas essa área
        # ainda não era colocada dentro de `area_principal`.
        montar_cards()
        area_principal.controls.append(cards_area)

        return ft.Column(
            [
                ft.Container(
                    content=busca_global,
                    height=86,
                    padding=ft.Padding.symmetric(
                        horizontal=10,
                        vertical=10,
                    ),
                    bgcolor="white",
                    border_radius=14,
                    shadow=sombra_cartao,
                ),
                area_principal,
            ],
            spacing=20,
            expand=True,
            scroll=ft.ScrollMode.AUTO,
        )

    # ------------------------------------------------------------------
    # PÁGINA: PEÇAS
    # ------------------------------------------------------------------
    def pagina_pecas():
        def fechar_dialog(dialogo):
            # Mantém o AlertDialog no overlay e apenas fecha a janela.
            # Isso evita que o diálogo fique preso ou seja recriado em um
            # estado inconsistente entre as navegações do Flet.
            dialogo.open = False
            page.update()

        def abrir_form_peca(peca=None):
            editando = peca is not None
            nome_f = campo("Nome da peça")
            qtd_f = campo("Quantidade")
            preco_f = campo("Preço (R$)")
            if peca:
                nome_f.value = peca["nome"] or ""
                qtd_f.value = str(peca["quantidade"] or 0)
                preco_f.value = str(peca["preco"] or 0).replace(".", ",")

            def salvar_form(e):
                nome_peca = (nome_f.value or "").strip()
                if not nome_peca:
                    page.overlay.append(ft.SnackBar(ft.Text("Informe o nome da peça."), bgcolor="#E5484D", open=True))
                    page.update()
                    return
                try:
                    qtd = int(qtd_f.value) if qtd_f.value else 0
                except ValueError:
                    qtd = 0
                try:
                    preco = float((preco_f.value or "0").replace(",", "."))
                except ValueError:
                    preco = 0.0
                if editando:
                    atualizar_peca(peca["id"], nome_peca, qtd, preco)
                else:
                    adicionar_peca(nome_peca, qtd, preco)
                fechar_dialog(dialogo)
                navegar("pecas")

            dialogo = ft.AlertDialog(
                modal=True,
                title=ft.Text("Editar peça" if editando else "Adicionar peça"),
                content=ft.Column([nome_f, qtd_f, preco_f], tight=True, width=400, spacing=12),
                actions=[
                    ft.TextButton("Cancelar", on_click=lambda e: fechar_dialog(dialogo)),
                    ft.ElevatedButton("Salvar", bgcolor="#3B5BFD", color="white", on_click=salvar_form),
                ], actions_alignment=ft.MainAxisAlignment.END,
            )
            page.overlay.append(dialogo); dialogo.open = True; page.update()

        def confirmar_exclusao(peca):
            def excluir(e):
                excluir_peca(peca["id"])
                fechar_dialog(dialogo)
                navegar("pecas")
            dialogo = ft.AlertDialog(
                modal=True, title=ft.Text("Excluir peça"),
                content=ft.Text(f"Deseja excluir a peça '{peca['nome']}'?"),
                actions=[
                    ft.TextButton("Cancelar", on_click=lambda e: fechar_dialog(dialogo)),
                    ft.ElevatedButton("Excluir", bgcolor="#E5484D", color="white", on_click=excluir),
                ],
            )
            page.overlay.append(dialogo); dialogo.open = True; page.update()

        pecas = listar_pecas()
        if not pecas:
            lista = ft.Container(
                content=ft.Column([
                    ft.Icon(ft.Icons.SETTINGS_INPUT_COMPONENT_ROUNDED, size=48, color="#B9BDC9"),
                    ft.Text("Nenhuma peça cadastrada ainda.", color="#9AA0AC"),
                    ft.Text("Use o botão acima para adicionar uma peça.", size=12, color="#B9BDC9"),
                ], horizontal_alignment=ft.CrossAxisAlignment.CENTER, alignment=ft.MainAxisAlignment.CENTER, spacing=6),
                alignment=ft.Alignment.CENTER, bgcolor="white", border_radius=12,
                border=ft.Border.all(1, "#E3E5EC"), padding=60,
            )
        else:
            linhas = []
            for p in pecas:
                linhas.append(ft.Container(
                    content=ft.Row([
                        ft.Column([
                            ft.Text(p["nome"], size=14, weight=ft.FontWeight.BOLD, color="#1F2430"),
                            ft.Text(f"Qtd: {p['quantidade']}  •  R$ {p['preco']:.2f}", size=12, color="#6B7280"),
                        ], spacing=2, expand=True),
                        ft.IconButton(icon=ft.Icons.EDIT_OUTLINED, tooltip="Editar",
                                      on_click=lambda e, x=p: abrir_form_peca(x)),
                        ft.IconButton(icon=ft.Icons.DELETE_OUTLINE_ROUNDED, icon_color="#E5484D", tooltip="Excluir",
                                      on_click=lambda e, x=p: confirmar_exclusao(x)),
                    ], vertical_alignment=ft.CrossAxisAlignment.CENTER),
                    bgcolor="white", border_radius=10, padding=14, shadow=sombra_cartao,
                ))
            lista = ft.Column(linhas, spacing=10)

        return ft.Column([
            ft.Row([
                ft.Column([
                    ft.Text("Peças", size=30, weight=ft.FontWeight.BOLD, color="#1F2430"),
                    ft.Text(f"{len(pecas)} peça(s) no estoque.", size=14, color="#6B7280"),
                ], spacing=2, expand=True),
                ft.ElevatedButton("Adicionar peça", icon=ft.Icons.ADD_CIRCLE_OUTLINE_ROUNDED,
                                  bgcolor="#3B5BFD", color="white", on_click=lambda e: abrir_form_peca()),
            ], vertical_alignment=ft.CrossAxisAlignment.CENTER),
            ft.Container(height=16), lista,
        ], spacing=4, scroll=ft.ScrollMode.AUTO, expand=True)

    # ------------------------------------------------------------------
    # PÁGINAS SIMPLES (placeholders)
    # ------------------------------------------------------------------
    def pagina_generica(titulo, subtitulo):
        return ft.Column(
            [
                ft.Text(titulo, size=24, weight=ft.FontWeight.BOLD, color="#1F2430"),
                ft.Text(subtitulo, size=13, color="#6B7280"),
                ft.Container(height=20),
                ft.Container(
                    content=ft.Column(
                        [
                            ft.Icon(ft.Icons.CONSTRUCTION, size=48, color="#B9BDC9"),
                            ft.Text("Em construção", color="#9AA0AC"),
                        ],
                        horizontal_alignment=ft.CrossAxisAlignment.CENTER,
                        alignment=ft.MainAxisAlignment.CENTER,
                    ),
                    alignment=ft.Alignment.CENTER,
                    bgcolor="white",
                    border_radius=12,
                    border=ft.Border.all(1, "#E3E5EC"),
                    padding=60,
                ),
            ],
            spacing=8,
            expand=True,
        )

    paginas = {
        "inicio": pagina_inicio,
        "nota_entrada": pagina_nota_entrada,
        "clientes": pagina_clientes,
        "aparelhos": pagina_aparelhos,
        "pecas": pagina_pecas,
        "desempenho": pagina_desempenho,
        "config": lambda: pagina_generica("Configurações", "Preferências do sistema."),
    }

    # ------------------------------------------------------------------
    # MENU LATERAL
    # ------------------------------------------------------------------
    itens_menu = [
        ("inicio", ft.Icons.HOME_ROUNDED, "Início"),
        ("nota_entrada", ft.Icons.ASSIGNMENT_ROUNDED, "Nota de Entrada"),
        ("clientes", ft.Icons.PEOPLE_ROUNDED, "Clientes"),
        ("aparelhos", ft.Icons.PHONE_ANDROID_ROUNDED, "Aparelhos"),
        ("pecas", ft.Icons.SETTINGS_INPUT_COMPONENT_ROUNDED, "Peças"),
        ("desempenho", ft.Icons.BAR_CHART_ROUNDED, "Desempenho"),
        ("config", ft.Icons.SETTINGS_ROUNDED, "Configurações"),
    ]

    botoes_menu = {}

    def navegar(chave):
        if chave not in paginas:
            return

        # Fecha qualquer diálogo que ainda esteja aberto antes de reconstruir
        # o conteúdo principal.
        for controle in list(page.overlay):
            if isinstance(controle, ft.AlertDialog):
                controle.open = False

        conteudo.controls.clear()
        conteudo.controls.append(
            ft.Container(content=paginas[chave](), padding=30, expand=True)
        )

        for k, btn in botoes_menu.items():
            ativo = k == chave
            btn.bgcolor = "#3B5BFD" if ativo else None
            btn.content.controls[0].color = "white" if ativo else "#5B6070"
            btn.content.controls[1].color = "white" if ativo else "#2B2F3A"
            btn.content.controls[1].weight = (
                ft.FontWeight.BOLD if ativo else ft.FontWeight.NORMAL
            )

        page.update()

    def criar_item_menu(chave, icone, texto):
        item = ft.Container(
            content=ft.Row(
                [
                    ft.Icon(icone, size=20, color="#5B6070"),
                    ft.Text(texto, size=14, color="#2B2F3A"),
                ],
                spacing=12,
            ),
            padding=ft.Padding.symmetric(vertical=12, horizontal=16),
            border_radius=8,
            on_click=lambda e, c=chave: navegar(c),
            ink=True,
        )
        botoes_menu[chave] = item
        return item

    menu_lateral = ft.Container(
        width=250,
        bgcolor="white",
        border=ft.Border.only(right=ft.BorderSide(1, "#E3E5EC")),
        content=ft.Column(
            [
                # Logo
                ft.Container(
                    content=ft.Row(
                        [
                            ft.Container(
                                content=ft.Icon(ft.Icons.PHONE_IPHONE_ROUNDED, color="white", size=22),
                                bgcolor="#3B5BFD",
                                border_radius=10,
                                padding=8,
                            ),
                            ft.Column(
                                [
                                    ft.Text("TechFix", size=17, weight=ft.FontWeight.BOLD, color="#1F2430"),
                                    ft.Text("Assistência Técnica", size=10, color="#9AA0AC"),
                                ],
                                spacing=0,
                            ),
                        ],
                        spacing=10,
                    ),
                    padding=20,
                ),
                ft.Divider(height=1, color="#E3E5EC"),
                ft.Container(
                    content=ft.Column(
                        [criar_item_menu(c, i, t) for c, i, t in itens_menu],
                        spacing=4,
                    ),
                    padding=ft.Padding.symmetric(vertical=12, horizontal=12),
                    expand=True,
                ),
                ft.Container(
                    content=ft.Text(f"versão {VERSAO_APP}", size=10, color="#B9BDC9"),
                    padding=ft.Padding.symmetric(vertical=10, horizontal=16),
                ),
            ],
            spacing=0,
        ),
    )

    page.add(
        ft.Row(
            [
                menu_lateral,
                ft.Container(content=conteudo, expand=True, bgcolor="#F2F3F7"),
            ],
            spacing=0,
            expand=True,
        )
    )

    navegar("inicio")


if __name__ == "__main__":
    ft.run(main)  