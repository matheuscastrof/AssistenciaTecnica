    page.title = "Assistência Técnica - Ordem de Serviço"
    page.window.width = 1200
    page.window.height = 800
    page.window.min_width = 900
    page.window.min_height = 600
    page.padding = 0
    page.bgcolor = "#F2F3F7"
    page.fonts = {}
    page.theme = ft.Theme(font_family="Arial")

    conteudo = ft.Column(expand=True, scroll=ft.ScrollMode.AUTO)

    sombra_cartao = ft.BoxShadow(
        spread_radius=0,
        blur_radius=10,
        color="#14000000",
        offset=ft.Offset(0, 2),
    )

    # ------------------------------------------------------------------
    # Helpers
    # ------------------------------------------------------------------
    def campo(label, expand=1, largura=None, multiline=False, min_lines=1, max_lines=1, password=False):
        return ft.TextField(
            label=label,
            expand=expand if largura is None else False,
            width=largura,
            multiline=multiline,
            min_lines=min_lines,
            max_lines=max_lines,
            password=password,
            can_reveal_password=password,
            border_radius=8,
            filled=True,
            bgcolor="white",
            border_color="#DADCE3",
            focused_border_color="#3B5BFD",
            content_padding=12,
        )

    def titulo_secao(texto):
        return ft.Text(texto, size=15, weight=ft.FontWeight.BOLD, color="#2B2F3A")

    def cartao(*controls, padding=20):
        return ft.Container(
            content=ft.Column(controls, spacing=14),
            bgcolor="white",
            border_radius=12,
            padding=padding,
            border=ft.Border.all(1, "#E3E5EC"),
        )

    # ------------------------------------------------------------------
    # PÁGINA: NOTA DE ENTRADA
    # ------------------------------------------------------------------
    def pagina_nota_entrada():
        # --- Dados do cliente ---
        # Mantemos os valores digitados através do on_change.
        # Em algumas versões do Flet, ler diretamente .value no clique
        # pode retornar o valor antigo do controle.
        valores_nota = {}

        def registrar_valor(e):
            label = getattr(e.control, "label", None)
            if label:
                valores_nota[label] = e.control.value or ""

        def campo_nota(label, **kwargs):
            controle = campo(label, **kwargs)
            controle.on_change = registrar_valor
            valores_nota[label] = ""
            return controle

        nome = campo_nota("Nome do cliente")
        telefone = campo_nota("Telefone de contato")
        endereco = campo_nota("Endereço")
        apelido = campo_nota("Apelido")

        bloco_cliente = cartao(
            titulo_secao("Dados do Cliente"),
            ft.Row([nome, telefone], spacing=14),
            ft.Row([endereco, apelido], spacing=14),
        )

        # --- Dados do aparelho ---
        marca = campo_nota("Marca do dispositivo")
        modelo = campo_nota("Modelo do dispositivo")
        senha = campo_nota("Senha", password=True)
        acessorios = campo_nota("Acessórios")

        bloco_aparelho = cartao(
            titulo_secao("Dados do Aparelho"),
            ft.Row([marca, modelo], spacing=14),
            ft.Row([senha, acessorios], spacing=14),
        )

        # --- Defeitos (checkboxes) ---
        lista_defeitos = [
            "Touch",
            "Display",
            "Molhou",
            "Formatação",
            "Software",
            "Bateria",
            "Não liga",
            "Tela trincada",
        ]

        # Guarda os defeitos através do próprio evento do Checkbox.
        # O Flet envia e.data como "true"/"false" no evento on_change.
        defeitos_selecionados = {d: False for d in lista_defeitos}

        texto_defeitos_selecionados = ft.Text(
            "Nenhum defeito selecionado",
            size=12,
            color="#6B7280",
        )

        def atualizar_um_defeito(defeito):
            def handler(e):
                # e.data é a forma mais confiável de obter o novo estado
                # do Checkbox no evento do Flet.
                valor = str(getattr(e, "data", "")).lower()
                if valor in ("true", "1"):
                    marcado = True
                elif valor in ("false", "0"):
                    marcado = False
                else:
                    marcado = bool(getattr(e.control, "value", False))

                defeitos_selecionados[defeito] = marcado

                marcados = [
                    d for d in lista_defeitos
                    if defeitos_selecionados[d]
                ]
                texto_defeitos_selecionados.value = (
                    "Selecionados: " + ", ".join(marcados)
                    if marcados else
                    "Nenhum defeito selecionado"
                )
                page.update()

            return handler

        checks_defeitos = [
            ft.Checkbox(
                label=defeito,
                value=False,
                on_change=atualizar_um_defeito(defeito),
            )
            for defeito in lista_defeitos
        ]

        linhas_defeitos = []
        for i in range(0, len(checks_defeitos), 4):
            linhas_defeitos.append(
                ft.Row(
                    checks_defeitos[i:i + 4],
                    spacing=20,
                    wrap=True,
                )
            )

        bloco_defeitos = cartao(
            titulo_secao("Defeito Relatado"),
            *linhas_defeitos,
            texto_defeitos_selecionados,
        )

       # --- Serviço autorizado / Valor / Orçamento ---

        campo_servico = campo_nota("Serviço realizado")
        campo_valor = campo_nota("Valor (R$)", largura=220)

        servico_autorizado_marcado = False
        orcamento_marcado = False


        def mudou_autorizado(e):
            nonlocal servico_autorizado_marcado


            servico_autorizado_marcado = str(e.data).lower() == "true"


        def mudou_orcamento(e):
            nonlocal orcamento_marcado

    
            orcamento_marcado = str(e.data).lower() == "true"

           


        check_autorizado = ft.Checkbox(
            label="Serviço Autorizado",
            value=False,
            on_change=mudou_autorizado,
        )

        check_orcamento = ft.Checkbox(
            label="Orçamento",
            value=False,
            on_change=mudou_orcamento,
        )


        bloco_servico = cartao(
            titulo_secao("Serviço"),
            campo_servico,
            ft.Row(
                [
                    check_autorizado,
                    campo_valor,
                    check_orcamento,
                ],
                spacing=20,
            ),
        )

        # --- Relatório técnico / Observações ---
        relatorio_tecnico = campo_nota(
            "Relatório Técnico", multiline=True, min_lines=5, max_lines=8
        )
        observacoes = campo_nota(
            "Observações", multiline=True, min_lines=5, max_lines=8
        )

        bloco_relatorio = cartao(
            ft.Row(
                [
                    ft.Column(
                        [titulo_secao("Relatório Técnico"), relatorio_tecnico],
                        expand=1,
                        spacing=8,
                    ),
                    ft.Column(
                        [titulo_secao("Observações"), observacoes],
                        expand=1,
                        spacing=8,
                    ),
                ],
                spacing=20,
                vertical_alignment=ft.CrossAxisAlignment.START,
            )
        )

        # --- Assinaturas ---
        def linha_assinatura(rotulo):
            return ft.Column(
                [
                    ft.Container(
                        height=60,
                        border=ft.Border.only(
                            bottom=ft.BorderSide(1, "#9AA0AC")
                        ),
                    ),
                    ft.Text(
                        rotulo,
                        size=12,
                        color="#6B7280",
                        text_align=ft.TextAlign.CENTER,
                    ),
                ],
                spacing=6,
                expand=1,
            )

        bloco_assinaturas = cartao(
            ft.Row(
                [
                    linha_assinatura("Assinatura do Técnico"),
                    linha_assinatura("Assinatura do Cliente"),
                ],
                spacing=40,
            )
        )

        # --- Botões de ação ---
        def salvar_click(e):
            # O nome também é recuperado do dicionário atualizado pelo on_change.
            nome_cliente = (
                valores_nota.get("Nome do cliente")
                or nome.value
                or ""
            ).strip()

            if not nome_cliente:
                snack_erro = ft.SnackBar(
                    ft.Text("Informe ao menos o nome do cliente."),
                    bgcolor="#E5484D",
                    open=True,
                )
                page.overlay.append(snack_erro)
                page.update()
                return

            # Usa os valores capturados pelos eventos on_change.
            # O fallback para .value mantém compatibilidade com versões
            # do Flet em que o controle já esteja sincronizado.
            def valor_campo(controle):
                return valores_nota.get(
                    controle.label,
                    controle.value or ""
                ) or ""

            # Usa o estado que foi registrado pelo evento on_change.
            # Não dependemos de checkbox.value neste momento.
            defeitos_marcados = [
                defeito
                for defeito in lista_defeitos
                if defeitos_selecionados.get(defeito, False)
            ]

            # Regra da Nota de Entrada:
            # Serviço Autorizado SEMPRE manda para Aguardando Peça.
            # Orçamento manda para Em Orçamento somente quando autorizado não está marcado.
            dados_nota = {
                "nome": nome_cliente,
                "telefone": valor_campo(telefone),
                "endereco": valor_campo(endereco),
                "apelido": valor_campo(apelido),
                "marca": valor_campo(marca),
                "modelo": valor_campo(modelo),
                "senha": valor_campo(senha),
                "acessorios": valor_campo(acessorios),
                "defeitos": ", ".join(defeitos_marcados),
                "servico": valor_campo(campo_servico),
                "autorizado": servico_autorizado_marcado,
                "valor": valor_campo(campo_valor),
                "orcamento": orcamento_marcado,
                "relatorio": valor_campo(relatorio_tecnico),
                "observacoes": valor_campo(observacoes),
            }

            # Regra DEFINITIVA da Nota de Entrada:
            # se o checkbox Serviço Autorizado estiver marcado,
            # o aparelho será gravado como Aguardando Peça.
            if servico_autorizado_marcado:
                dados_nota["status"] = "aguardando_peca"

            elif orcamento_marcado:
                dados_nota["status"] = "em_orcamento"

            else:
                dados_nota["status"] = "aguardando_autorizacao"

        
            salvar_nota(dados_nota)

            snack = ft.SnackBar(
                ft.Text("Nota de entrada salva com sucesso!"),
                bgcolor="#22A559",
                open=True,
            )
            page.overlay.append(snack)

            # Limpa os campos antes de reconstruir a página.
            limpar_click(None)

            # Recarrega a lista diretamente do SQLite.
            navegar("aparelhos")

            page.update()

        def limpar_click(e):
            nonlocal servico_autorizado_marcado, orcamento_marcado
            valores_nota.clear()

            controles = [
                nome, telefone, endereco, apelido,
                marca, modelo, senha, acessorios,
                campo_servico, campo_valor,
                relatorio_tecnico, observacoes,
            ]

            for c in controles:
                c.value = ""
                valores_nota[c.label] = ""

            for c in checks_defeitos:
                c.value = False

            for defeito in defeitos_selecionados:
                defeitos_selecionados[defeito] = False

            texto_defeitos_selecionados.value = "Nenhum defeito selecionado"

            check_autorizado.value = False
            check_orcamento.value = False
            servico_autorizado_marcado = False
            orcamento_marcado = False
            # servico_autorizado_marcado["valor"] = False
            # orcamento_marcado["valor"] = False

            if e is not None:
                page.update()

        botoes = ft.Row(
            [
                ft.OutlinedButton("Limpar", on_click=limpar_click),
                ft.ElevatedButton(
                    "Salvar Nota de Entrada",
                    bgcolor="#3B5BFD",
                    color="white",
                    on_click=salvar_click,
                ),
            ],
            alignment=ft.MainAxisAlignment.END,
            spacing=10,
        )

        return ft.Column(
            [
                ft.Text(
                    "Nota de Entrada",
                    size=24,
                    weight=ft.FontWeight.BOLD,
                    color="#1F2430",
                ),
                ft.Text(
                    "Preencha os dados abaixo para registrar a entrada do aparelho.",
                    size=13,
                    color="#6B7280",
                ),
                ft.Container(height=8),
                bloco_cliente,
                bloco_aparelho,
                bloco_defeitos,
                bloco_servico,
                bloco_relatorio,
                bloco_assinaturas,
                botoes,
            ],
            spacing=16,
            scroll=ft.ScrollMode.AUTO,
            expand=True,
        )

    # ------------------------------------------------------------------
    # PÁGINA: INÍCIO
    # ------------------------------------------------------------------
