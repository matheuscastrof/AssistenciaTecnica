    def pagina_clientes():
        clientes = listar_clientes()

        def fechar_dialog(dialogo):
            # Mantém o AlertDialog no overlay e apenas fecha a janela.
            # Isso evita que o diálogo fique preso ou seja recriado em um
            # estado inconsistente entre as navegações do Flet.
            dialogo.open = False
            page.update()

        def abrir_form_cliente(cliente=None):
            editando = cliente is not None
            nome_f = campo("Nome do cliente")
            telefone_f = campo("Telefone de contato")
            endereco_f = campo("Endereço")
            apelido_f = campo("Apelido")

            if cliente:
                nome_f.value = cliente["nome"] or ""
                telefone_f.value = cliente["telefone"] or ""
                endereco_f.value = cliente["endereco"] or ""
                apelido_f.value = cliente["apelido"] or ""

            def salvar_form(e):
                nome_cliente = (nome_f.value or "").strip()
                if not nome_cliente:
                    page.overlay.append(ft.SnackBar(
                        ft.Text("Informe ao menos o nome do cliente."),
                        bgcolor="#E5484D", open=True,
                    ))
                    page.update()
                    return
                if editando:
                    atualizar_cliente(cliente["id"], nome_cliente, telefone_f.value or "",
                                      endereco_f.value or "", apelido_f.value or "")
                else:
                    adicionar_cliente(nome_cliente, telefone_f.value or "",
                                      endereco_f.value or "", apelido_f.value or "")
                fechar_dialog(dialogo)
                navegar("clientes")

            dialogo = ft.AlertDialog(
                modal=True,
                title=ft.Text("Editar cliente" if editando else "Adicionar cliente"),
                content=ft.Column(
                    [nome_f, telefone_f, endereco_f, apelido_f],
                    tight=True, width=430, spacing=12,
                ),
                actions=[
                    ft.TextButton("Cancelar", on_click=lambda e: fechar_dialog(dialogo)),
                    ft.ElevatedButton("Salvar", bgcolor="#3B5BFD", color="white", on_click=salvar_form),
                ],
                actions_alignment=ft.MainAxisAlignment.END,
            )
            page.overlay.append(dialogo)
            dialogo.open = True
            page.update()

        def confirmar_exclusao(cliente):
            def excluir(e):
                excluir_cliente(cliente["id"])
                fechar_dialog(dialogo)
                navegar("clientes")

            dialogo = ft.AlertDialog(
                modal=True,
                title=ft.Text("Excluir cliente"),
                content=ft.Text(
                    f"Deseja excluir {cliente['nome']}? Os aparelhos vinculados a este cliente também serão excluídos."
                ),
                actions=[
                    ft.TextButton("Cancelar", on_click=lambda e: fechar_dialog(dialogo)),
                    ft.ElevatedButton("Excluir", bgcolor="#E5484D", color="white", on_click=excluir),
                ],
            )
            page.overlay.append(dialogo)
            dialogo.open = True
            page.update()

        if not clientes:
            lista = ft.Container(
                content=ft.Column(
                    [
                        ft.Icon(ft.Icons.PEOPLE_OUTLINE_ROUNDED, size=48, color="#B9BDC9"),
                        ft.Text("Nenhum cliente cadastrado ainda.", color="#9AA0AC"),
                        ft.Text("Use o botão acima para adicionar um cliente.", size=12, color="#B9BDC9"),
                    ],
                    horizontal_alignment=ft.CrossAxisAlignment.CENTER,
                    alignment=ft.MainAxisAlignment.CENTER,
                    spacing=6,
                ),
                alignment=ft.Alignment.CENTER,
                bgcolor="white", border_radius=12,
                border=ft.Border.all(1, "#E3E5EC"), padding=60,
            )
        else:
            linhas = []
            for c in clientes:
                linhas.append(
                    ft.Container(
                        content=ft.Row(
                            [
                                ft.Container(
                                    content=ft.Icon(ft.Icons.PERSON_ROUNDED, color="white", size=20),
                                    bgcolor="#2E8BF0", border_radius=30, padding=10,
                                ),
                                ft.Column(
                                    [
                                        ft.Text(c["nome"], size=15, weight=ft.FontWeight.BOLD, color="#1F2430"),
                                        ft.Text(f"{c['telefone'] or '-'}  •  {c['apelido'] or 'sem apelido'}", size=12, color="#6B7280"),
                                        ft.Text(c["endereco"] or "-", size=12, color="#9AA0AC"),
                                    ], spacing=2, expand=True,
                                ),
                                ft.Container(
                                    content=ft.Text(f"{c['total_aparelhos']} aparelho(s)", size=12, color="#2E8BF0", weight=ft.FontWeight.BOLD),
                                    bgcolor="#E8F1FD", border_radius=20,
                                    padding=ft.Padding.symmetric(vertical=6, horizontal=12),
                                ),
                                ft.IconButton(icon=ft.Icons.EDIT_OUTLINED, tooltip="Editar",
                                              on_click=lambda e, x=c: abrir_form_cliente(x)),
                                ft.IconButton(icon=ft.Icons.DELETE_OUTLINE_ROUNDED, icon_color="#E5484D", tooltip="Excluir",
                                              on_click=lambda e, x=c: confirmar_exclusao(x)),
                            ], spacing=10, vertical_alignment=ft.CrossAxisAlignment.CENTER,
                        ),
                        bgcolor="white", border_radius=10, padding=16, shadow=sombra_cartao,
                    )
                )
            lista = ft.Column(linhas, spacing=12)

        return ft.Column(
            [
                ft.Row(
                    [
                        ft.Column([
                            ft.Text("Clientes", size=30, weight=ft.FontWeight.BOLD, color="#1F2430"),
                            ft.Text(f"{len(clientes)} cliente(s) cadastrado(s).", size=14, color="#6B7280"),
                        ], spacing=2, expand=True),
                        ft.ElevatedButton("Adicionar cliente", icon=ft.Icons.PERSON_ADD_ROUNDED,
                                          bgcolor="#3B5BFD", color="white", on_click=lambda e: abrir_form_cliente()),
                    ], vertical_alignment=ft.CrossAxisAlignment.CENTER,
                ),
                ft.Container(height=20), lista,
            ], spacing=4, scroll=ft.ScrollMode.AUTO, expand=True,
        )

