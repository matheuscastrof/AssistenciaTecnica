def listar_clientes():
    conn = get_conn()
    rows = conn.execute(
        """SELECT c.*, COUNT(a.id) as total_aparelhos
           FROM clientes c
           LEFT JOIN aparelhos a ON a.cliente_id = c.id
           GROUP BY c.id
           ORDER BY c.id DESC"""
    ).fetchall()
    conn.close()
    return rows


def listar_aparelhos():
    conn = get_conn()
    rows = conn.execute(
        """SELECT a.*, c.nome as cliente_nome, c.telefone as cliente_telefone
           FROM aparelhos a
           LEFT JOIN clientes c ON c.id = a.cliente_id
           ORDER BY a.id DESC"""
    ).fetchall()
    conn.close()
    return rows


