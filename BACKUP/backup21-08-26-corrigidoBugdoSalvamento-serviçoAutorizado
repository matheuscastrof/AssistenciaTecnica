def get_conn():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    return conn


def init_db():
    conn = get_conn()
    conn.executescript(
        """
        CREATE TABLE IF NOT EXISTS clientes (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nome TEXT NOT NULL,
            telefone TEXT,
            endereco TEXT,
            apelido TEXT
        );
        CREATE TABLE IF NOT EXISTS aparelhos (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            cliente_id INTEGER,
            marca TEXT,
            modelo TEXT,
            senha TEXT,
            acessorios TEXT,
            defeitos TEXT,
            servico TEXT,
            autorizado INTEGER DEFAULT 0,
            valor TEXT,
            orcamento INTEGER DEFAULT 0,
            relatorio TEXT,
            observacoes TEXT,
            status TEXT DEFAULT 'em_manutencao',
            data_entrada TEXT,
            FOREIGN KEY(cliente_id) REFERENCES clientes(id)
        );
        CREATE TABLE IF NOT EXISTS pecas (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nome TEXT NOT NULL,
            quantidade INTEGER DEFAULT 0,
            preco REAL DEFAULT 0
        );
        """
    )

    # --- Migração automática: adiciona qualquer coluna que esteja faltando ---
    colunas_esperadas = {
        "cliente_id": "INTEGER",
        "marca": "TEXT",
        "modelo": "TEXT",
        "senha": "TEXT",
        "acessorios": "TEXT",
        "defeitos": "TEXT",
        "servico": "TEXT",
        "autorizado": "INTEGER DEFAULT 0",
        "valor": "TEXT",
        "orcamento": "INTEGER DEFAULT 0",
        "relatorio": "TEXT",
        "observacoes": "TEXT",
        "status": "TEXT DEFAULT 'em_manutencao'",
        "data_entrada": "TEXT",
    }
    colunas_atuais = {row["name"] for row in conn.execute("PRAGMA table_info(aparelhos)")}
    for nome_col, tipo_col in colunas_esperadas.items():
        if nome_col not in colunas_atuais:
            conn.execute(f"ALTER TABLE aparelhos ADD COLUMN {nome_col} {tipo_col}")

    conn.commit()
    conn.close()

def calcular_status_automatico(dados, status_padrao="em_orcamento"):
    """Define o status pelas marcações da tela. Serviço autorizado tem prioridade."""
    autorizado = bool(dados.get("autorizado"))
    orcamento = bool(dados.get("orcamento"))

    if autorizado:
        return "aguardando_peca"
    if orcamento:
        return "em_orcamento"
    return status_padrao


def salvar_nota(dados):
    conn = get_conn()
    cur = conn.cursor()
    cur.execute(
        "INSERT INTO clientes (nome, telefone, endereco, apelido) VALUES (?, ?, ?, ?)",
        (dados["nome"], dados["telefone"], dados["endereco"], dados["apelido"]),
    )
    cliente_id = cur.lastrowid
    cur.execute(
                 """INSERT INTO aparelhos
            (cliente_id, marca, modelo, senha, acessorios, defeitos, servico, autorizado, valor,
             orcamento, relatorio, observacoes, status, data_entrada)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
        (
            cliente_id,
            dados["marca"], dados["modelo"], dados["senha"], dados["acessorios"],
                         dados["defeitos"], dados["servico"], 1 if dados["autorizado"] else 0, dados["valor"],
            1 if dados["orcamento"] else 0, dados["relatorio"], dados["observacoes"],
            calcular_status_automatico(dados),
            datetime.now().strftime("%d/%m/%Y %H:%M"),
        ),
    )
    # GARANTIA: depois de inserir, força novamente o status no próprio banco.
    # Isso evita que qualquer valor padrão/status anterior substitua a regra dos checkboxes.
    aparelho_id = cur.lastrowid
    if dados.get("autorizado"):
        status_final = "aguardando_peca"
    elif dados.get("orcamento"):
        status_final = "em_orcamento"
    else:
        status_final = dados.get("status", "em_orcamento")

    cur.execute(
        "UPDATE aparelhos SET status = ? WHERE id = ?",
        (status_final, aparelho_id),
    )

    conn.commit()
    conn.close()


